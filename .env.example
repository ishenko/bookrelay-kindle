BOOKRELAY_PAIRING_ADMIN_KEY=replace-with-a-random-secret
# Optional fallback for legacy pairing requests. The /pair page accepts one address per device.
BOOKRELAY_DEFAULT_KINDLE_EMAIL=
BOOKRELAY_DELIVERY_ENABLED=true
BOOKRELAY_SOURCE_URL=https://flibusta.is
BOOKRELAY_DB=/data/relay.sqlite3
BOOKRELAY_SMTP_HOST=smtp.example.com
BOOKRELAY_SMTP_PORT=587
BOOKRELAY_SMTP_USERNAME=relay@example.com
BOOKRELAY_SMTP_PASSWORD=replace-me
BOOKRELAY_SMTP_FROM=relay@example.com
BOOKRELAY_SMTP_TLS=true
